<Window x:Class="MediaCraft.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MediaCraft — FFmpeg 转码工具"
        Width="1200" Height="780"
        MinWidth="980" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource PageBrush}"
        FontFamily="Microsoft YaHei UI, Microsoft YaHei, Segoe UI"
        FontSize="12"
        Foreground="{StaticResource TextBrush}">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ═══════════════ 主标签页 ═══════════════ -->
        <TabControl Grid.Row="0" x:Name="MainTabs" Background="Transparent" BorderThickness="0">
            <TabItem Header="转码">
                <Border Style="{StaticResource CardBorder}" Margin="0,8,0,0">
                    <TextBlock x:Name="PlaceholderTranscode" Text="转码页（阶段 3 接入）" Style="{StaticResource HintText}" />
                </Border>
            </TabItem>
            <TabItem Header="队列">
                <Border Style="{StaticResource CardBorder}" Margin="0,8,0,0">
                    <TextBlock x:Name="PlaceholderQueue" Text="队列页（阶段 4 接入）" Style="{StaticResource HintText}" />
                </Border>
            </TabItem>
            <TabItem Header="预设">
                <Border Style="{StaticResource CardBorder}" Margin="0,8,0,0">
                    <TextBlock x:Name="PlaceholderPresets" Text="预设页（阶段 5 接入）" Style="{StaticResource HintText}" />
                </Border>
            </TabItem>
            <TabItem Header="设置">
                <Border Style="{StaticResource CardBorder}" Margin="0,8,0,0">
                    <TextBlock x:Name="PlaceholderSettings" Text="设置页（阶段 6 接入）" Style="{StaticResource HintText}" />
                </Border>
            </TabItem>
        </TabControl>

        <!-- ═══════════════ 日志开关 ═══════════════ -->
        <Grid Grid.Row="1" Margin="0,6,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ToggleButton x:Name="LogToggle"
                          Grid.Column="0"
                          Content="显示日志"
                          Padding="10,3"
                          FontSize="11"
                          Cursor="Hand"
                          Checked="OnLogToggleChanged"
                          Unchecked="OnLogToggleChanged" />
            <TextBlock Grid.Column="1"
                       x:Name="LogSummary"
                       Margin="10,0,0,0"
                       VerticalAlignment="Center"
                       Style="{StaticResource HintText}"
                       Text="" />
            <Button Grid.Column="2"
                    Content="打开日志目录"
                    Style="{StaticResource LinkButton}"
                    Click="OnOpenLogDirectoryClick" />
        </Grid>

        <!-- ═══════════════ 日志面板 ═══════════════ -->
        <Border Grid.Row="2"
                x:Name="LogPanel"
                Style="{StaticResource CardBorder}"
                Margin="0,6,0,0"
                Padding="6"
                Visibility="Collapsed"
                Height="180">
            <ListBox x:Name="LogList"
                     BorderThickness="0"
                     Background="Transparent"
                     FontFamily="Consolas, Cascadia Mono, Courier New"
                     FontSize="11.5"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto"
                     VirtualizingPanel.IsVirtualizing="True"
                     VirtualizingPanel.VirtualizationMode="Recycling">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Line}" TextWrapping="NoWrap">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Level}" Value="Warn">
                                            <Setter Property="Foreground" Value="{StaticResource WarnBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Level}" Value="Error">
                                            <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Level}" Value="Debug">
                                            <Setter Property="Foreground" Value="{StaticResource FaintBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <!-- ═══════════════ 状态栏 ═══════════════ -->
        <StatusBar Grid.Row="3" Margin="0,6,0,0" Background="Transparent" BorderThickness="0" BorderBrush="Transparent">
            <StatusBarItem>
                <TextBlock x:Name="StatusFfmpeg" Text="ffmpeg：未检测" Style="{StaticResource HintText}" />
            </StatusBarItem>
            <Separator />
            <StatusBarItem>
                <TextBlock x:Name="StatusQueue" Text="队列：空闲" Style="{StaticResource HintText}" />
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock x:Name="StatusVersion" Text="v1.0.0" Style="{StaticResource HintText}" />
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
