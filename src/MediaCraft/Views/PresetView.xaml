<UserControl x:Class="MediaCraft.Views.PresetView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Margin="0,8,0,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="380" MinWidth="300" />
            <ColumnDefinition Width="8" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ═══════════════ 左：预设列表 ═══════════════ -->
        <Border Grid.Column="0" Style="{StaticResource CardBorder}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0">
                    <TextBlock DockPanel.Dock="Left" Text="预设列表" Style="{StaticResource SectionTitle}" Margin="0" VerticalAlignment="Center" />
                    <TextBlock DockPanel.Dock="Right" Text="{Binding CountText}" HorizontalAlignment="Right" Style="{StaticResource HintText}" VerticalAlignment="Center" />
                    <TextBlock Text="" />
                </DockPanel>

                <ListBox Grid.Row="1"
                         Margin="0,6,0,0"
                         ItemsSource="{Binding Presets}"
                         SelectedItem="{Binding SelectedPreset, Mode=TwoWay}"
                         BorderThickness="0"
                         HorizontalContentAlignment="Stretch">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="2,4">
                                <DockPanel>
                                    <Border DockPanel.Dock="Left"
                                            Background="{StaticResource SoftBrush}"
                                            CornerRadius="3"
                                            Padding="5,1"
                                            Margin="0,0,6,0"
                                            VerticalAlignment="Center"
                                            Visibility="{Binding IsBuiltIn, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="内置" FontSize="10" Foreground="{StaticResource MutedBrush}" />
                                    </Border>
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                </DockPanel>
                                <TextBlock Text="{Binding Summary}" Style="{StaticResource HintText}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding IntentSummary}" Style="{StaticResource HintText}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,6,0,0">
                    <Button Content="导入预设" Style="{StaticResource SecondaryButton}" Click="OnImportClick" Margin="0,0,6,0" />
                    <Button Content="导出全部自定义" Style="{StaticResource SecondaryButton}" Click="OnExportAllClick" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══════════════ 右：预设详情与操作 ═══════════════ -->
        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" Padding="0,0,4,0">
            <StackPanel>
                <Border Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Text="预设详情" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="{Binding SelectedPreset.FullDescription}"
                                   TextWrapping="Wrap"
                                   Foreground="{StaticResource MutedBrush}"
                                   Margin="0,0,0,8" />

                        <TextBlock Text="名称" Style="{StaticResource FieldLabel}" Margin="0,0,0,2" />
                        <TextBox Text="{Binding EditName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Text="描述" Style="{StaticResource FieldLabel}" Margin="0,8,0,2" />
                        <TextBox Text="{Binding EditDescription, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Text="内置预设不能改名或覆盖，可以「另存为副本」后自由修改。"
                                   Style="{StaticResource HintText}"
                                   Margin="0,4,0,0"
                                   Visibility="{Binding IsBuiltInSelected, Converter={StaticResource BoolToVis}}" />

                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button Content="保存为新预设" Style="{StaticResource PrimaryButton}" Command="{Binding SaveCurrentAsNewCommand}" Margin="0,0,6,0" />
                            <Button Content="保存名称/描述修改" Style="{StaticResource SecondaryButton}" Command="{Binding ApplyRenameCommand}" Margin="0,0,6,0" />
                            <Button Content="用当前参数更新此预设" Style="{StaticResource SecondaryButton}" Command="{Binding UpdateFromCurrentCommand}" />
                        </StackPanel>

                        <TextBlock Text="{Binding StatusText}" Style="{StaticResource HintText}" Margin="0,8,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Text="套用" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="「应用到全部文件」会把预设的参数与轨道动作铺到列表里每个文件上（轨道动作按每个文件自己的流重新落实）。"
                                   Style="{StaticResource HintText}" Margin="0,0,0,8" />
                        <StackPanel Orientation="Horizontal">
                            <Button Content="应用到当前文件" Style="{StaticResource PrimaryButton}" Command="{Binding ApplyToCurrentCommand}" Margin="0,0,6,0" />
                            <Button Content="应用到全部文件" Style="{StaticResource SecondaryButton}" Command="{Binding ApplyToAllFilesCommand}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Text="管理" Style="{StaticResource SectionTitle}" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <Button Content="另存为副本" Style="{StaticResource SecondaryButton}" Command="{Binding DuplicateCommand}" Margin="0,0,6,0" />
                            <Button Content="导出此预设" Style="{StaticResource SecondaryButton}" Click="OnExportSelectedClick" Margin="0,0,6,0" />
                            <Button Content="删除" Style="{StaticResource DangerButton}" Command="{Binding DeleteSelectedCommand}" />
                        </StackPanel>
                        <TextBlock Text="导出的 JSON 可以拷到别的机器上，用左侧「导入预设」加载；也支持单个预设文件与预设数组两种结构。"
                                   Style="{StaticResource HintText}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
