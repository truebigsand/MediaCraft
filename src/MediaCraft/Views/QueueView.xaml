<UserControl x:Class="MediaCraft.Views.QueueView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Margin="0,8,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ═══════════════ 工具栏 ═══════════════ -->
        <Border Grid.Row="0" Style="{StaticResource CardBorder}">
            <StackPanel>
                <DockPanel>
                    <TextBlock DockPanel.Dock="Left" Text="队列" Style="{StaticResource SectionTitle}" Margin="0" VerticalAlignment="Center" />
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <TextBlock Text="并发" VerticalAlignment="Center" Style="{StaticResource HintText}" Margin="0,0,6,0" />
                        <ComboBox Width="58"
                                  ItemsSource="{Binding ConcurrencyOptions}"
                                  SelectedItem="{Binding MaxConcurrency, Mode=TwoWay}" />
                        <Button Content="{Binding PauseButtonText}" Style="{StaticResource SecondaryButton}" Command="{Binding TogglePauseCommand}" Margin="10,0,6,0" />
                        <Button Content="取消当前" Style="{StaticResource SecondaryButton}" Command="{Binding CancelSelectedCommand}" Margin="0,0,6,0" />
                        <Button Content="重试失败" Style="{StaticResource SecondaryButton}" Command="{Binding RetryFailedCommand}" Margin="0,0,6,0" />
                        <Button Content="清除已完成" Style="{StaticResource SecondaryButton}" Command="{Binding ClearFinishedCommand}" Margin="0,0,6,0" />
                        <Button Content="清空队列" Style="{StaticResource DangerButton}" Command="{Binding ClearAllCommand}" />
                    </StackPanel>
                    <TextBlock Text="" />
                </DockPanel>

                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <Button Content="↑ 上移" Style="{StaticResource LinkButton}" Command="{Binding MoveUpCommand}" Margin="0,0,10,0" />
                    <Button Content="↓ 下移" Style="{StaticResource LinkButton}" Command="{Binding MoveDownCommand}" Margin="0,0,10,0" />
                    <Button Content="移除选中" Style="{StaticResource LinkButton}" Command="{Binding RemoveSelectedCommand}" Margin="0,0,10,0" />
                    <Button Content="取消全部" Style="{StaticResource LinkButton}" Command="{Binding CancelAllCommand}" Margin="0,0,10,0" />
                    <Button Content="开始 / 继续" Style="{StaticResource LinkButton}" Command="{Binding StartCommand}" />
                </StackPanel>

                <TextBlock Text="多个硬件编码任务会争抢同一个 GPU 编码器：超过 3 路通常不会更快，反而可能更慢或爆显存。"
                           Style="{StaticResource HintText}"
                           Foreground="{StaticResource WarnBrush}"
                           Margin="0,6,0,0"
                           Visibility="{Binding ShowConcurrencyHint, Converter={StaticResource BoolToVis}}" />
            </StackPanel>
        </Border>

        <!-- ═══════════════ 总体进度 ═══════════════ -->
        <Border Grid.Row="1" Style="{StaticResource CardBorder}">
            <StackPanel>
                <DockPanel>
                    <TextBlock DockPanel.Dock="Left" Text="{Binding OverallText}" Style="{StaticResource FieldLabel}" />
                    <TextBlock DockPanel.Dock="Right" Text="{Binding SummaryText}" HorizontalAlignment="Right" Style="{StaticResource HintText}" />
                    <TextBlock Text="" />
                </DockPanel>
                <ProgressBar Height="14" Margin="0,6,0,0" Maximum="100" Value="{Binding OverallPercent}" />
            </StackPanel>
        </Border>

        <!-- ═══════════════ 任务列表 ═══════════════ -->
        <Border Grid.Row="2" Style="{StaticResource CardBorder}" Padding="0">
            <Grid>
                <ListBox x:Name="JobList"
                         ItemsSource="{Binding Jobs}"
                         SelectedItem="{Binding SelectedJob, Mode=TwoWay}"
                         BorderThickness="0"
                         HorizontalContentAlignment="Stretch"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="0,0,0,1" Padding="8,6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="66" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="300" />
                                        <ColumnDefinition Width="150" />
                                    </Grid.ColumnDefinitions>

                                    <!-- 状态 -->
                                    <TextBlock Grid.Column="0" Text="{Binding StateText}" FontWeight="SemiBold" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding State}" Value="Running">
                                                        <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding State}" Value="Preparing">
                                                        <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding State}" Value="Completed">
                                                        <Setter Property="Foreground" Value="{StaticResource OkBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding State}" Value="Failed">
                                                        <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                    <!-- 文件名 + 参数摘要 + 输出/错误 -->
                                    <StackPanel Grid.Column="1" Margin="0,0,10,0">
                                        <TextBlock Text="{Binding SourceName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding SourcePath}" />
                                        <TextBlock Text="{Binding ParametersSummary}" Style="{StaticResource HintText}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding OutputPath}" Style="{StaticResource HintText}" TextTrimming="CharacterEllipsis"
                                                   Visibility="{Binding OutputPath, Converter={StaticResource NotNullToVis}}" />
                                        <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" FontSize="11.5"
                                                   Visibility="{Binding ErrorMessage, Converter={StaticResource NotNullToVis}}" />
                                        <TextBlock Text="{Binding StatusText}" Style="{StaticResource HintText}" />
                                    </StackPanel>

                                    <!-- 进度 -->
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,10,0">
                                        <ProgressBar Height="16" Maximum="100" Value="{Binding ProgressPercent}"
                                                     IsIndeterminate="{Binding IsProgressIndeterminate}" />
                                        <DockPanel Margin="0,2,0,0">
                                            <TextBlock DockPanel.Dock="Left" Text="{Binding ProgressPercent, StringFormat={}{0:0.0}%}" Style="{StaticResource HintText}" />
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding SpeedText}" HorizontalAlignment="Right" Style="{StaticResource HintText}" />
                                            <TextBlock Text="" />
                                        </DockPanel>
                                    </StackPanel>

                                    <!-- 剩余 / 用时 -->
                                    <StackPanel Grid.Column="3" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding EtaText, StringFormat=剩余 {0}}" Style="{StaticResource HintText}"
                                                   Visibility="{Binding EtaText, Converter={StaticResource NotNullToVis}}" />
                                        <TextBlock Text="{Binding ElapsedText, StringFormat=用时 {0}}" Style="{StaticResource HintText}"
                                                   Visibility="{Binding ElapsedText, Converter={StaticResource NotNullToVis}}" />
                                        <TextBlock Text="{Binding PreflightSummary}" Style="{StaticResource HintText}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <TextBlock Text="队列是空的&#x0a;在「转码」页把文件加入队列后，这里会显示每个任务的进度"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           TextAlignment="Center"
                           IsHitTestVisible="False"
                           Foreground="{StaticResource FaintBrush}"
                           Visibility="{Binding Jobs, Converter={StaticResource EmptyToVis}}" />
            </Grid>
        </Border>

        <!-- ═══════════════ 选中任务详情 ═══════════════ -->
        <Expander Grid.Row="3" Header="选中任务的详细诊断" Margin="0,6,0,0" IsExpanded="False">
            <Border Style="{StaticResource CardBorder}" Margin="0,4,0,0">
                <StackPanel>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="复制命令行" Style="{StaticResource SecondaryButton}" Click="OnCopyCommandClick" Margin="6,0,0,0" />
                        <Button DockPanel.Dock="Right" Content="打开输出位置" Style="{StaticResource SecondaryButton}" Click="OnOpenOutputClick" />
                        <TextBlock Text="执行的完整命令行（可复制）" Style="{StaticResource FieldLabel}" />
                    </DockPanel>
                    <TextBox Text="{Binding SelectedJob.CommandLine, Mode=OneWay}"
                             IsReadOnly="True"
                             TextWrapping="Wrap"
                             MaxHeight="90"
                             Margin="0,4,0,0"
                             FontFamily="Consolas, Cascadia Mono, Courier New"
                             VerticalScrollBarVisibility="Auto"
                             Foreground="{StaticResource MutedBrush}" />

                    <TextBlock Text="ffmpeg 输出尾部（失败时用于定位原因）" Style="{StaticResource FieldLabel}" Margin="0,8,0,0" />
                    <TextBox Text="{Binding SelectedJob.ErrorDetail, Mode=OneWay}"
                             IsReadOnly="True"
                             TextWrapping="Wrap"
                             MaxHeight="150"
                             Margin="0,4,0,0"
                             FontFamily="Consolas, Cascadia Mono, Courier New"
                             VerticalScrollBarVisibility="Auto"
                             Foreground="{StaticResource MutedBrush}" />
                </StackPanel>
            </Border>
        </Expander>
    </Grid>
</UserControl>
