<UserControl x:Class="MediaCraft.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,8,0,0" Padding="0,0,4,0">
        <StackPanel>

            <!-- ═══════════════ ffmpeg ═══════════════ -->
            <Border Style="{StaticResource CardBorder}">
                <StackPanel>
                    <TextBlock Text="ffmpeg" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="留空 = 自动探测（依次找 设置 → PATH → 常见安装位置）。找不到时可以在下面手动指定。"
                               Style="{StaticResource HintText}" Margin="0,0,0,8" />

                    <TextBlock Text="当前检测结果" Style="{StaticResource FieldLabel}" Margin="0,0,0,2" />
                    <TextBox Text="{Binding DetectedStatus, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"
                             MaxHeight="76" VerticalScrollBarVisibility="Auto"
                             FontFamily="Consolas, Cascadia Mono, Courier New" Foreground="{StaticResource MutedBrush}" />

                    <TextBlock Text="ffmpeg.exe 路径" Style="{StaticResource FieldLabel}" Margin="0,8,0,2" />
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="浏览" Style="{StaticResource SecondaryButton}" Command="{Binding BrowseFfmpegCommand}" Margin="6,0,0,0" />
                        <TextBox Text="{Binding Settings.FfmpegPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </DockPanel>

                    <TextBlock Text="ffprobe.exe 路径" Style="{StaticResource FieldLabel}" Margin="0,8,0,2" />
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="浏览" Style="{StaticResource SecondaryButton}" Command="{Binding BrowseFfprobeCommand}" Margin="6,0,0,0" />
                        <TextBox Text="{Binding Settings.FfprobePath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </DockPanel>

                    <CheckBox Content="启动时逐个真跑一帧探测编码器可用性（编译进去 ≠ 能跑；关掉可加快启动）"
                              IsChecked="{Binding Settings.ProbeEncodersOnStartup, Mode=TwoWay}" Margin="0,8,0,0" />

                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="重新检测" Style="{StaticResource PrimaryButton}" Command="{Binding ReinitializeCommand}" Margin="0,0,6,0" />
                        <Button Content="清空手动路径" Style="{StaticResource SecondaryButton}" Command="{Binding ClearPathsCommand}" Margin="0,0,6,0" />
                        <Button Content="运行快速自检" Style="{StaticResource SecondaryButton}" Command="{Binding RunQuickSelfTestCommand}" />
                    </StackPanel>

                    <TextBlock Text="{Binding ActionStatus}" Style="{StaticResource HintText}" Margin="0,6,0,0" />

                    <TextBlock Text="编码器可用性" Style="{StaticResource FieldLabel}" Margin="0,10,0,2" />
                    <TextBox Text="{Binding EncoderStatus, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"
                             MaxHeight="150" VerticalScrollBarVisibility="Auto"
                             FontFamily="Consolas, Cascadia Mono, Courier New" Foreground="{StaticResource MutedBrush}" />
                    <TextBlock Text="快速自检会把「定位 ffmpeg → 能力探测 → 编码器功能探测 → 生成一段测试素材」跑一遍并生成报告，用于排查「为什么这个编码器用不了」。"
                               Style="{StaticResource HintText}" Margin="0,4,0,0" />
                </StackPanel>
            </Border>

            <!-- ═══════════════ 输出默认值 ═══════════════ -->
            <Border Style="{StaticResource CardBorder}">
                <StackPanel>
                    <TextBlock Text="输出默认值" Style="{StaticResource SectionTitle}" />

                    <TextBlock Text="默认输出目录（留空 = 源文件所在目录）" Style="{StaticResource FieldLabel}" Margin="0,0,0,2" />
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="清空" Style="{StaticResource SecondaryButton}" Command="{Binding ClearOutputDirectoryCommand}" Margin="6,0,0,0" />
                        <Button DockPanel.Dock="Right" Content="浏览" Style="{StaticResource SecondaryButton}" Command="{Binding BrowseOutputDirectoryCommand}" Margin="6,0,0,0" />
                        <TextBox Text="{Binding Settings.DefaultOutputDirectory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </DockPanel>

                    <TextBlock Text="默认容器" Style="{StaticResource FieldLabel}" Margin="0,8,0,2" />
                    <ComboBox ItemsSource="{Binding Containers}" DisplayMemberPath="DisplayName"
                              SelectedValuePath="Extension" SelectedValue="{Binding Settings.DefaultContainer, Mode=TwoWay}" />

                    <TextBlock Text="默认文件名模板" Style="{StaticResource FieldLabel}" Margin="0,8,0,2" />
                    <TextBox Text="{Binding Settings.NamingTemplate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Text="可用占位符：{name}  {encoder}  {quality}  {date}  {time}  {index}"
                               Style="{StaticResource HintText}" Margin="0,2,0,0" />

                    <TextBlock Text="新文件默认编码器" Style="{StaticResource FieldLabel}" Margin="0,8,0,2" />
                    <ComboBox ItemsSource="{Binding Encoders}" DisplayMemberPath="DisplayName"
                              SelectedValuePath="Id" SelectedValue="{Binding Settings.DefaultEncoderId, Mode=TwoWay}" />

                    <CheckBox Content="允许覆盖同名文件（默认关闭：自动加序号，且绝不覆盖源文件）"
                              IsChecked="{Binding Settings.AllowOverwrite, Mode=TwoWay}" Margin="0,8,0,0" />
                    <CheckBox Content="MP4/MOV 添加 +faststart"
                              IsChecked="{Binding Settings.FastStart, Mode=TwoWay}" Margin="0,4,0,0" />
                </StackPanel>
            </Border>

            <!-- ═══════════════ 队列与界面 ═══════════════ -->
            <Border Style="{StaticResource CardBorder}">
                <StackPanel>
                    <TextBlock Text="队列与界面" Style="{StaticResource SectionTitle}" />

                    <TextBlock Text="默认并发任务数（1-8）" Style="{StaticResource FieldLabel}" Margin="0,0,0,2" />
                    <ComboBox Width="90" HorizontalAlignment="Left"
                              ItemsSource="{Binding ConcurrencyOptions}"
                              SelectedItem="{Binding Settings.DefaultConcurrency, Mode=TwoWay}" />
                    <TextBlock Text="多个硬件编码任务会争抢同一个 GPU 编码器：超过 3 路通常不会更快。"
                               Style="{StaticResource HintText}" Margin="0,3,0,0" />

                    <CheckBox Content="退出后保留队列（下次启动恢复未完成的任务）"
                              IsChecked="{Binding Settings.PersistQueue, Mode=TwoWay}" Margin="0,8,0,0" />
                    <CheckBox Content="启动时最大化窗口"
                              IsChecked="{Binding Settings.StartMaximized, Mode=TwoWay}" Margin="0,4,0,0" />
                </StackPanel>
            </Border>

            <!-- ═══════════════ 日志 ═══════════════ -->
            <Border Style="{StaticResource CardBorder}">
                <StackPanel>
                    <TextBlock Text="日志" Style="{StaticResource SectionTitle}" />

                    <TextBlock Text="日志级别" Style="{StaticResource FieldLabel}" Margin="0,0,0,2" />
                    <ComboBox Width="120" HorizontalAlignment="Left"
                              ItemsSource="{Binding LogLevels}"
                              SelectedItem="{Binding LogLevelText, Mode=TwoWay}" />
                    <TextBlock Text="Debug 会记录每个任务的完整 ffmpeg 输出（排障用，平时建议 Info）；日志按天切分并保留 7 天。"
                               Style="{StaticResource HintText}" Margin="0,3,0,0" />

                    <TextBlock Text="日志目录" Style="{StaticResource FieldLabel}" Margin="0,8,0,2" />
                    <TextBox Text="{Binding LogDirectory, Mode=OneWay}" IsReadOnly="True" Foreground="{StaticResource MutedBrush}" />

                    <TextBlock Text="设置文件" Style="{StaticResource FieldLabel}" Margin="0,8,0,2" />
                    <TextBox Text="{Binding SettingsFilePath, Mode=OneWay}" IsReadOnly="True" Foreground="{StaticResource MutedBrush}" />

                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="打开日志目录" Style="{StaticResource SecondaryButton}" Command="{Binding OpenLogDirectoryCommand}" Margin="0,0,6,0" />
                        <Button Content="打开设置文件位置" Style="{StaticResource SecondaryButton}" Command="{Binding OpenSettingsFileCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
